# Mirrors kagent helm values in deployment/argocd/applications/infra/prod-kagent.yaml:
#   providers.openAI.model            -> OPENAI_MODEL
#   providers.openAI.config.reasoningEffort -> OPENAI_REASONING_EFFORT
# The deployed kagent reads its key from the kagent-openai-key secret which is
# sourced from the GCP secret `production-nexus-openai-api-key`.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=high

DB_TOOLBOX_MCP_URL=https://db-toolbox-mcp.internal.getvocal.ai/mcp
GRAFANA_MCP_URL=http://mcp-grafana.internal.getvocal.ai/sse

ENVIRONMENT=production
LOOKUP_BUFFER_MINUTES=5
MAX_AGENT_ITERATIONS=25
